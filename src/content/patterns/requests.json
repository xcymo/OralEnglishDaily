        "zh": "我在想你能不能帮我一下。"
      },
      {
        "en": "I was wondering if you could check this for me.",
        "zh": "我在想你能不能帮我看一下这个。"
      }
    ],
    "substitutions": [
      { "zh": "能不能帮我看一下这个", "en": "check this for me" },
      { "zh": "能不能多给我十分钟", "en": "give me ten more minutes" },
      { "zh": "能不能把会议往后挪", "en": "push the meeting back" }
